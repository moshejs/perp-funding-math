{
  "name": "perp-funding-math",
  "version": "1.1.0",
  "description": "Perpetual-futures funding math — the funding-rate formula (premium index, interest, clamp, caps), payments (longs-pay-shorts convention), APR/APY annualization for any interval, cumulative funding, cross-venue funding-arb carry and breakeven. Zero dependencies.",
  "keywords": [
    "funding-rate",
    "perpetual-futures",
    "perps",
    "crypto",
    "trading",
    "funding-arbitrage",
    "carry",
    "apr",
    "apy",
    "derivatives",
    "finance"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/perp-funding-math.git"
  },
  "bugs": "https://github.com/moshejs/perp-funding-math/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
